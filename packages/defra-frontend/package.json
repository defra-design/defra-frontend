{
  "name": "defra-frontend",
  "version": "0.3.0",
  "description": "Defra Frontend — GOV.UK Frontend, themed for Defra services, built for minimum payload.",
  "license": "OGL-UK-3.0",
  "keywords": [
    "defra",
    "govuk",
    "govuk-frontend",
    "design-system",
    "govuk-prototype-kit-plugin"
  ],
  "homepage": "https://defra-design.github.io/defra-frontend/docs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/defra-design/defra-frontend.git",
    "directory": "packages/defra-frontend"
  },
  "bugs": {
    "url": "https://github.com/defra-design/defra-frontend/issues"
  },
  "type": "module",
  "sass": "./src/defra-frontend.scss",
  "exports": {
    "./sass": "./src/defra-frontend.scss",
    "./views": "./src",
    "./render": "./lib/render.mjs",
    "./javascript": "./src/defra-frontend.mjs"
  },
  "files": [
    "src",
    "!src/stories",
    "lib",
    "govuk-prototype-kit.config.json"
  ],
  "scripts": {
    "build": "sass --load-path=../../node_modules --style=compressed --no-source-map src/defra-frontend.scss dist/defra-frontend.min.css",
    "drift": "node scripts/drift.mjs",
    "carbon": "node scripts/carbon.mjs",
    "stories": "node scripts/generate-stories.mjs",
    "boundary": "node scripts/boundary.mjs"
  },
  "peerDependencies": {
    "govuk-frontend": "^6.4.0"
  },
  "dependencies": {
    "nunjucks": "^3.2.4"
  },
  "devDependencies": {
    "@tgwf/co2": "^0.19.0",
    "sass": "^1.102.0"
  }
}
