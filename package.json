{
  "name": "defra-frontend-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "drift": "npm run drift -w @defra/frontend",
    "carbon": "npm run carbon -w @defra/frontend --",
    "stories": "npm run stories -w @defra/frontend",
    "storybook": "npm run build -w @defra/frontend && npm run dev -w @defra/storybook",
    "build": "npm run build -w @defra/frontend",
    "check": "npm run build && npm run boundary && npm run drift && npm run carbon",
    "boundary": "npm run boundary -w @defra/frontend"
  },
  "dependencies": {
    "@tgwf/co2": "^0.19.0",
    "govuk-frontend": "^6.4.0",
    "nunjucks": "^3.2.4",
    "sass": "^1.102.0"
  }
}
